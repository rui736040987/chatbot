GIN_MODE=release
LOG_LEVEL=info
TZ=Asia/Shanghai
WEKNORA_LANGUAGE=zh-CN
DB_DRIVER=sqlite
DB_PATH=/data/files/weknora.db
RETRIEVE_DRIVER=sqlite
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
STREAM_MANAGER_TYPE=memory
SYSTEM_AES_KEY=GENERATE_AES_KEY
JWT_SECRET=GENERATE_JWT_SECRET
NEO4J_ENABLE=false
WEKNORA_SANDBOX_MODE=disabled
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=admin@example.com
CONCURRENCY_POOL_SIZE=3
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc
WEKNORA_OUTBOUND_DIAL_TIMEOUT=30s
SSRF_WHITELIST_EXTRA=host.docker.internal
WEKNORA_MODEL_MAX_CONCURRENCY=4
